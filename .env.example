# Server-side Gemini API Key (NEVER prefix secret keys with VITE_ so Vite does not bundle them into browser JS)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.0-flash

# Internal Invite-Only Pilot Access Gate (Server-side only — never prefix with VITE_)
# Leave blank for open local development; set one or comma-separated codes for production pilot
INVITE_ACCESS_CODE=
# Optional custom HMAC secret for signing session cookies
SESSION_SECRET=
# Optional comma-separated allowed CORS origins (same-origin allowed by default when blank)
ALLOWED_ORIGIN=

# Stripe Secret & Webhook Keys for Serverless Functions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Optional Tier & Partner Customization
# VITE_DEFAULT_TIER=starter     # Options: starter, pro, team (default: starter)
# VITE_PARTNER_CODE=VISPARTNER  # Custom partner VIP unlock key (default: VISPARTNER)
